{
  "name": "axonyx-vscode",
  "displayName": "Axonyx",
  "description": "VS Code language support for Axonyx .asx frontend and .ax backend files.",
  "version": "0.0.8",
  "publisher": "vladanpro",
  "license": "MIT",
  "icon": "assets/axonyx-x-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "axonyx",
    "asx",
    "ax",
    "rust",
    "framework",
    "syntax-highlighting"
  ],
  "activationEvents": [
    "onLanguage:ax",
    "onCommand:axonyx.runDiagnostics",
    "onCommand:axonyx.formatDocument"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --check extension.js && node scripts/lsp-client-smoke.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "ax",
        "aliases": [
          "Axonyx",
          "ax"
        ],
        "extensions": [
          ".asx",
          ".ax"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/axonyx-x-icon.svg",
          "dark": "./assets/axonyx-x-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ax",
        "scopeName": "source.ax",
        "path": "./syntaxes/ax.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ax",
        "path": "./snippets/ax.json"
      }
    ],
    "commands": [
      {
        "command": "axonyx.runDiagnostics",
        "title": "Axonyx: Run Diagnostics"
      },
      {
        "command": "axonyx.formatDocument",
        "title": "Axonyx: Format Document"
      }
    ],
    "configuration": {
      "title": "Axonyx",
      "properties": {
        "axonyx.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use the persistent axonyx-lsp process for diagnostics, formatting, navigation, hover, and completion when available."
        },
        "axonyx.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional absolute path to the axonyx-lsp executable. Leave empty for local workspace or PATH discovery."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vladanPro/axonyx-vscode.git"
  }
}
