{
  "Page": {
    "prefix": "ax-page",
    "body": [
      "page ${1:Home}() {",
      "  return ASX {",
      "    <Head>",
      "      <Title>${2:Axonyx}</Title>",
      "    </Head>",
      "",
      "    <Container max=\"xl\">",
      "      ${0}",
      "    </Container>",
      "  }",
      "}"
    ],
    "description": "Create a function-shaped Pages V2 Axonyx page"
  },
  "Page With Data": {
    "prefix": "ax-page-data",
    "body": [
      "import { ${1:loadItems} } from \"./loader.ax\"",
      "",
      "page ${2:Items}() {",
      "  data ${3:items}: List<${4:Item}> = ${1:loadItems}()",
      "",
      "  return ASX {",
      "    <Container max=\"xl\">",
      "      <Each items={${3:items}} as=\"${5:item}\">",
      "        ${0}",
      "      </Each>",
      "    </Container>",
      "  }",
      "}"
    ],
    "description": "Create a Pages V2 page with a typed data binding"
  },
  "Component": {
    "prefix": "ax-component",
    "body": [
      "component ${1:ThemeSwitcher}(${2:label}: String = \"${3:Theme}\") {",
      "  render ASX {",
      "    ${0}",
      "  }",
      "}"
    ],
    "description": "Create a typed Pages V2 component"
  },
  "Query": {
    "prefix": "ax-query",
    "body": [
      "query ${1:loadPosts}(${2:status}: String) -> List<${3:Post}> {",
      "  data ${4:posts} = db.${5:posts}.where({ ${2:status}: ${2:status} }).order({ ${6:created_at}: \"desc\" }).limit(${7:6}).all()",
      "  return ${4:posts}",
      "}"
    ],
    "description": "Create an Axonyx query/data loader function"
  },
  "Action": {
    "prefix": "ax-action",
    "body": [
      "action ${1:createPost}(${2:input}: ${3:CreatePostInput}) {",
      "  guard(${2:input}.${4:title}, \"${5:Title is required}\")",
      "  data ${6:post} = db.${7:posts}.insert(${2:input})",
      "  refresh ${8:loadPosts}",
      "  return ${6:post}",
      "}"
    ],
    "description": "Create an Axonyx action/mutation function"
  },
  "Scope": {
    "prefix": "ax-scope",
    "body": [
      "import { ${1:Layout} } from \"./page.ax\"",
      "import * as ${2:Domain} from \"./domain.ax\"",
      "",
      "scope ${3:Blog}<${2:Domain}> {",
      "  state ${4:theme}: ${5:Theme} = \"${6:silver}\"",
      "",
      "  render ${1}()",
      "}"
    ],
    "description": "Create an Axonyx scope composition block"
  },
  "Import Component": {
    "prefix": "ax-import",
    "body": [
      "import { ${1:SectionCard} } from \"${2:@axonyx/ui/foundry/SectionCard.ax}\""
    ],
    "description": "Import an Axonyx component"
  },
  "Head": {
    "prefix": "ax-head",
    "body": [
      "<Head>",
      "  <Title>${1:Page Title}</Title>",
      "  <Theme>${2:silver}</Theme>",
      "  ${0}",
      "</Head>"
    ],
    "description": "Insert an Axonyx Head block"
  },
  "Foundry Head": {
    "prefix": "ax-head-full",
    "body": [
      "<Head>",
      "  <Title>${1:Page Title}</Title>",
      "  <Theme>${2:silver}</Theme>",
      "  <Meta name=\"description\" content=\"${3:Page description}\" />",
      "  <Link rel=\"stylesheet\" href=\"/css/axonyx-ui/index.css\" />",
      "</Head>"
    ],
    "description": "Insert a fuller Axonyx Head block with theme and stylesheet"
  },
  "Each": {
    "prefix": "ax-each",
    "body": [
      "<Each items={${1:items}} as=\"${2:item}\">",
      "  ${0}",
      "</Each>"
    ],
    "description": "Insert an Each block"
  },
  "If": {
    "prefix": "ax-if",
    "body": [
      "<If when={${1:condition}}>",
      "  ${0}",
      "</If>"
    ],
    "description": "Insert an If block"
  },
  "Slot": {
    "prefix": "ax-slot",
    "body": [
      "<Slot />"
    ],
    "description": "Insert a Slot tag"
  },
  "Copy": {
    "prefix": "ax-copy",
    "body": [
      "<Copy>",
      "  ${0}",
      "</Copy>"
    ],
    "description": "Insert a Copy block"
  },
  "Lead Copy": {
    "prefix": "ax-copy-lead",
    "body": [
      "<Copy tone=\"lead\">",
      "  ${0}",
      "</Copy>"
    ],
    "description": "Insert a lead Copy block"
  },
  "Card": {
    "prefix": "ax-card",
    "body": [
      "<Card title=\"${1:Card title}\">",
      "  ${0}",
      "</Card>"
    ],
    "description": "Insert a base Card block"
  },
  "SectionCard": {
    "prefix": "ax-section-card",
    "body": [
      "<SectionCard title=\"${1:Section title}\">",
      "  ${0}",
      "</SectionCard>"
    ],
    "description": "Insert a Foundry SectionCard block"
  },
  "HeroCard": {
    "prefix": "ax-hero-card",
    "body": [
      "<HeroCard title=\"${1:Hero title}\">",
      "  ${0}",
      "</HeroCard>"
    ],
    "description": "Insert a Foundry HeroCard block"
  },
  "ContentGrid": {
    "prefix": "ax-grid",
    "body": [
      "<ContentGrid cols={${1:2}} gap=\"${2:lg}\">",
      "  ${0}",
      "</ContentGrid>"
    ],
    "description": "Insert a Foundry ContentGrid block"
  },
  "SiteShell": {
    "prefix": "ax-site-shell",
    "body": [
      "<SiteShell max=\"${1:xl}\">",
      "  ${0}",
      "</SiteShell>"
    ],
    "description": "Insert a Foundry SiteShell block"
  },
  "Import Foundry Set": {
    "prefix": "ax-import-foundry",
    "body": [
      "import { SiteShell } from \"@axonyx/ui/foundry/SiteShell.ax\"",
      "import { HeroCard } from \"@axonyx/ui/foundry/HeroCard.ax\"",
      "import { ContentGrid } from \"@axonyx/ui/foundry/ContentGrid.ax\"",
      "import { SectionCard } from \"@axonyx/ui/foundry/SectionCard.ax\""
    ],
    "description": "Import the common Foundry UI component set"
  },
  "Import Foundry Form Set": {
    "prefix": "ax-import-form",
    "body": [
      "import { Form } from \"@axonyx/ui/foundry/Form.ax\"",
      "import { FormGroup } from \"@axonyx/ui/foundry/FormGroup.ax\"",
      "import { Fieldset } from \"@axonyx/ui/foundry/Fieldset.ax\"",
      "import { Legend } from \"@axonyx/ui/foundry/Legend.ax\"",
      "import { Field } from \"@axonyx/ui/foundry/Field.ax\"",
      "import { Input } from \"@axonyx/ui/foundry/Input.ax\"",
      "import { Button } from \"@axonyx/ui/foundry/Button.ax\""
    ],
    "description": "Import native Foundry form primitives"
  },
  "Import Foundry Table Set": {
    "prefix": "ax-import-table",
    "body": [
      "import { Table } from \"@axonyx/ui/foundry/Table.ax\"",
      "import { TableHead } from \"@axonyx/ui/foundry/TableHead.ax\"",
      "import { TableBody } from \"@axonyx/ui/foundry/TableBody.ax\"",
      "import { TableRow } from \"@axonyx/ui/foundry/TableRow.ax\"",
      "import { TableCell } from \"@axonyx/ui/foundry/TableCell.ax\"",
      "import { TableHeaderCell } from \"@axonyx/ui/foundry/TableHeaderCell.ax\""
    ],
    "description": "Import native Foundry table primitives"
  },
  "Form": {
    "prefix": "ax-form",
    "body": [
      "<Form method=\"${1:post}\" action=\"${2:/api/action}\" surface=\"${3:forged}\">",
      "  ${0}",
      "</Form>"
    ],
    "description": "Insert a Foundry Form block"
  },
  "Form Group": {
    "prefix": "ax-form-group",
    "body": [
      "<FormGroup cols=\"${1:2}\" gap=\"${2:lg}\">",
      "  ${0}",
      "</FormGroup>"
    ],
    "description": "Insert a responsive Foundry FormGroup"
  },
  "Fieldset": {
    "prefix": "ax-fieldset",
    "body": [
      "<Fieldset surface=\"${1:forged}\">",
      "  <Legend>${2:Section}</Legend>",
      "  ${0}",
      "</Fieldset>"
    ],
    "description": "Insert a Fieldset with Legend"
  },
  "Field With Input": {
    "prefix": "ax-field-input",
    "body": [
      "<Field htmlFor=\"${1:field-id}\">",
      "  <span slot=\"label\">${2:Label}</span>",
      "  <Input id=\"${1:field-id}\" name=\"${3:name}\" placeholder=\"${4:Value}\" />",
      "  <span slot=\"hint\">${5:Helper text}</span>",
      "</Field>"
    ],
    "description": "Insert a Field with Input, label, and hint"
  },
  "Table": {
    "prefix": "ax-table",
    "body": [
      "<Table zebra=\"${1:true}\">",
      "  <TableHead>",
      "    <TableRow>",
      "      <TableHeaderCell>${2:Name}</TableHeaderCell>",
      "      <TableHeaderCell align=\"right\">${3:Status}</TableHeaderCell>",
      "    </TableRow>",
      "  </TableHead>",
      "  <TableBody>",
      "    <TableRow>",
      "      <TableCell>${4:Item}</TableCell>",
      "      <TableCell align=\"right\">${5:Ready}</TableCell>",
      "    </TableRow>",
      "  </TableBody>",
      "</Table>"
    ],
    "description": "Insert a compound Foundry Table"
  },
  "Pagination": {
    "prefix": "ax-pagination",
    "body": [
      "<Pagination current=\"${1:2}\" total=\"${2:8}\" previous=\"${3:#}\" next=\"${4:#}\">",
      "  <PaginationItem href=\"${5:#}\">1</PaginationItem>",
      "  <PaginationItem href=\"${6:#}\" current=\"true\">2</PaginationItem>",
      "  <PaginationEllipsis />",
      "  <PaginationItem href=\"${7:#}\">8</PaginationItem>",
      "</Pagination>"
    ],
    "description": "Insert a compound Foundry Pagination"
  },
  "AppShell": {
    "prefix": "ax-app-shell",
    "body": [
      "<AppShell gap=\"${1:lg}\">",
      "  <Sidebar slot=\"sidebar\">",
      "    ${2}",
      "  </Sidebar>",
      "  <Main>",
      "    ${0}",
      "  </Main>",
      "</AppShell>"
    ],
    "description": "Insert an AppShell layout block"
  },
  "Page With Foundry": {
    "prefix": "ax-page-foundry",
    "body": [
      "import { ContentGrid } from \"@axonyx/ui/foundry/ContentGrid.ax\"",
      "import { SectionCard } from \"@axonyx/ui/foundry/SectionCard.ax\"",
      "",
      "page ${1:Home}() {",
      "  return ASX {",
      "    <Head>",
      "      <Title>${2:Axonyx}</Title>",
      "    </Head>",
      "",
      "    <Container max=\"xl\">",
      "      <ContentGrid cols={2} gap=\"lg\">",
      "        <SectionCard title=\"${3:Section title}\">",
      "          ${0}",
      "        </SectionCard>",
      "      </ContentGrid>",
      "    </Container>",
      "  }",
      "}"
    ],
    "description": "Create a page that starts with Foundry imports and layout"
  },
  "Route": {
    "prefix": "ax-route",
    "body": [
      "route ${1:GET} \"${2:/api/example}\"",
      "  ${0:return { ok: true }}"
    ],
    "description": "Create a basic Axonyx route"
  }
}
