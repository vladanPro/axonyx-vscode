{
  "name": "Axonyx",
  "scopeName": "source.ax",
  "fileTypes": ["ax"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#route-declaration" },
    { "include": "#declarations" },
    { "include": "#bindings" },
    { "include": "#jsx-tags" },
    { "include": "#legacy-tags" },
    { "include": "#expressions" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ax",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ax",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.ax",
          "begin": "^\\s*(import)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.ax" }
          },
          "end": "$",
          "patterns": [
            {
              "name": "keyword.control.from.ax",
              "match": "\\bfrom\\b"
            },
            {
              "name": "keyword.control.as.ax",
              "match": "\\bas\\b"
            },
            {
              "name": "entity.name.type.ax",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "variable.other.readwrite.ax",
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
            },
            {
              "include": "#strings"
            },
            {
              "name": "punctuation.definition.brace.ax",
              "match": "[{}]"
            }
          ]
        }
      ]
    },
    "route-declaration": {
      "patterns": [
        {
          "name": "meta.route.ax",
          "match": "^\\s*(route)\\s+(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD)\\s+(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "keyword.declaration.route.ax" },
            "2": { "name": "keyword.other.http-method.ax" },
            "3": { "name": "string.quoted.double.ax" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.page-declaration.ax",
          "match": "^\\s*(page|layout|component|scope)\\s+([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": { "name": "keyword.declaration.ax" },
            "2": { "name": "entity.name.type.ax" }
          }
        },
        {
          "name": "meta.backend-function-declaration.ax",
          "match": "^\\s*(export\\s+)?(query|loader|action|helper|job)\\s+([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": { "name": "keyword.control.export.ax" },
            "2": { "name": "keyword.declaration.function.ax" },
            "3": { "name": "entity.name.function.ax" }
          }
        },
        {
          "name": "meta.backend-declaration.ax",
          "match": "^\\s*(backend|actions|domain)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.ax" }
          }
        },
        {
          "name": "meta.type-declaration.ax",
          "match": "^\\s*(type|interface|struct|enum|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": { "name": "keyword.declaration.ax" },
            "2": { "name": "entity.name.type.ax" }
          }
        },
        {
          "name": "meta.function-declaration.ax",
          "match": "^\\s*(export\\s+)?(fn|function)\\s+([A-Za-z_][A-Za-z0-9_]*)?",
          "captures": {
            "1": { "name": "keyword.control.export.ax" },
            "2": { "name": "keyword.declaration.function.ax" },
            "3": { "name": "entity.name.function.ax" }
          }
        },
        {
          "name": "meta.directive.ax",
          "match": "^\\s*(title|meta|link|script|theme|state|data|const|let|return|each|if|else|form|guard|require|client|style|render|props)\\b",
          "captures": {
            "1": { "name": "keyword.control.directive.ax" }
          }
        },
        {
          "name": "meta.return-asx.ax",
          "match": "\\b(return)\\s+(ASX)\\b",
          "captures": {
            "1": { "name": "keyword.control.return.ax" },
            "2": { "name": "support.type.asx.ax" }
          }
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "name": "meta.binding.ax",
          "match": "^\\s*(state|data|const|let)\\s+([a-z_][A-Za-z0-9_]*)(\\??)(?:\\s*(:)\\s*([A-Z][A-Za-z0-9_]*(?:<[^>\\n]+>)?(?:\\[\\])?))?",
          "captures": {
            "1": { "name": "keyword.declaration.variable.ax" },
            "2": { "name": "variable.other.definition.ax" },
            "3": { "name": "keyword.operator.optional.ax" },
            "4": { "name": "punctuation.separator.type.ax" },
            "5": { "name": "entity.name.type.ax" }
          }
        },
        {
          "name": "meta.typed-parameter.ax",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(\\??)(\\s*:\\s*)([A-Z][A-Za-z0-9_]*(?:<[^>\\n]+>)?(?:\\[\\])?)",
          "captures": {
            "1": { "name": "variable.parameter.ax" },
            "2": { "name": "keyword.operator.optional.ax" },
            "3": { "name": "punctuation.separator.type.ax" },
            "4": { "name": "entity.name.type.ax" }
          }
        }
      ]
    },
    "jsx-tags": {
      "patterns": [
        {
          "name": "meta.tag.block.ax",
          "begin": "(</?)(Head|Title|Theme|Meta|Link|Script|Each|If|Else|Slot)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.ax" },
            "2": { "name": "support.type.builtin.ax" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.ax" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name",
              "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:.-]*\\b(?=\\s*=)"
            },
            {
              "name": "keyword.operator.assignment",
              "match": "="
            },
            {
              "include": "#strings"
            },
            {
              "include": "#expressions"
            }
          ]
        },
        {
          "name": "meta.tag.block.ax",
          "begin": "(</?)([A-Z][A-Za-z0-9._:-]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.ax" },
            "2": { "name": "support.class.component" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.ax" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name",
              "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:.-]*\\b(?=\\s*=)"
            },
            {
              "name": "keyword.operator.assignment",
              "match": "="
            },
            {
              "include": "#strings"
            },
            {
              "include": "#expressions"
            }
          ]
        },
        {
          "name": "meta.tag.block.ax",
          "begin": "(</?)([a-z][A-Za-z0-9._:-]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.ax" },
            "2": { "name": "entity.name.tag" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.ax" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name",
              "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:.-]*\\b(?=\\s*=)"
            },
            {
              "name": "keyword.operator.assignment",
              "match": "="
            },
            {
              "include": "#strings"
            },
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "legacy-tags": {
      "patterns": [
        {
          "name": "meta.legacy-builtin.ax",
          "match": "^\\s*(Head|Title|Theme|Meta|Link|Script|Each|If|Else|Slot)(?=\\s+(?:[a-zA-Z_][A-Za-z0-9_-]*\\s*:|->)|\\s*$)",
          "captures": {
            "1": { "name": "support.type.builtin.ax" }
          }
        },
        {
          "name": "meta.legacy-component.ax",
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)(?=\\s+(?:[a-zA-Z_][A-Za-z0-9_-]*\\s*:|->)|\\s*$)",
          "captures": {
            "1": { "name": "support.class.component" }
          }
        },
        {
          "name": "meta.legacy-tag.ax",
          "match": "^\\s*([a-z][A-Za-z0-9_-]*)(?=\\s+(?:[a-zA-Z_][A-Za-z0-9_-]*\\s*:|->)|\\s*$)",
          "captures": {
            "1": { "name": "entity.name.tag" }
          }
        },
        {
          "name": "entity.other.attribute-name",
          "match": "\\b[a-zA-Z_][A-Za-z0-9_-]*\\b(?=\\s*:)"
        },
        {
          "name": "keyword.operator.assignment",
          "match": "->|:"
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "name": "meta.embedded.expression.ax",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.ax" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.ax" }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#types"
            },
            {
              "include": "#function-calls"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#keywords"
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ax",
          "match": "\\b(String|Number|Bool|Boolean|List|Map|Optional|Option|Result|Secret|DateTime|Json|Html|ASX|Vec|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|string|bool)\\b"
        },
        {
          "name": "entity.name.type.ax",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s*(?:<|\\[\\]|\\?|[,)=;{]))"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "support.function.builtin.ax",
          "match": "\\b(log|guard|refresh|invalidate|redirect|json|ok|notFound)!(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.member.ax",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.ax",
          "match": "\\b(?!if\\b|for\\b|while\\b|match\\b|return\\b|guard\\b|require\\b)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "support.variable.runtime.ax",
          "match": "\\b(db|input|request|params|query|env|app|page|session|State|Content|Env|Auth|Crypto)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ax",
          "match": "\\?\\?|\\?\\.|=>|->|==|!=|<=|>=|&&|\\|\\||[+*/%<>!=?-]"
        },
        {
          "name": "punctuation.separator.ax",
          "match": "[,;:]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ax",
          "match": "\\b(import|export|from|as|page|route|layout|component|scope|backend|domain|helper|job|loader|query|action|actions|title|meta|link|script|theme|state|data|const|let|return|ASX|each|in|if|else|form|when|guard|require|client|JS|WASM|style|render|props|type|interface|struct|enum|impl|fn|function|match|for|while|break|continue|async|await)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ax",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.numeric.ax",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ax",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.ax" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.ax" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ax",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ax",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.ax" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.ax" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.ax",
              "match": "\\\\."
            }
          ]
        }
      ]
    }
  }
}
